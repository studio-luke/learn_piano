// Cloudflare 배포 설정. main 브랜치에 push하면 Cloudflare가 `npx wrangler deploy`로 이 설정대로 올려요.
// 사이트로 공개되는 것은 빌드 결과인 dist/ 폴더뿐이에요 (src/ 원본, tests/, tools/, supabase/, README 등은 사이트에 안 올라감).
// dist/는 Cloudflare가 배포 직전에 `npm run build`로 만들어요 (Cloudflare 대시보드의 Build command 설정).
{
  "name": "learn-piano",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  }
}
