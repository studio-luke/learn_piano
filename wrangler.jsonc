// Cloudflare 배포 설정. main 브랜치에 push하면 Cloudflare가 `npx wrangler deploy`로 이 설정대로 올려요.
// main이 아닌 브랜치(예: accounts)는 미리보기 주소에만 올라가요 (실제 사이트는 그대로).
// 사이트로 공개되는 것은 빌드 결과인 dist/ 폴더뿐이에요 (src/ 원본, tests/, tools/, supabase/, README 등은 사이트에 안 올라감).
{
  "name": "learn-piano",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // 배포 직전에 dist/ 만들기. 배포 도구(wrangler)가 직접 실행하므로 대시보드의 Build command 설정이
  // 빠지거나 적용되지 않아도 항상 빌드돼요 (대시보드에도 있으면 두 번 빌드 — 1초도 안 걸려서 상관없음).
  "build": { "command": "npm run build" },
  // 브랜치 미리보기(`wrangler preview`, Cloudflare가 미리보기 배포에 쓰는 명령)에 필요한 항목. 비어 있어도 됨.
  "previews": {},
  "assets": {
    "directory": "./dist"
  }
}
